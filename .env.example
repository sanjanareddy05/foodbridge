# Database for local host commands. Docker compose's api service overrides this
# with postgresql://postgres:password@db:5432/foodbridge inside the network.
DATABASE_URL=postgresql://postgres:password@localhost:5432/foodbridge

# App
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

# Security
JWT_SECRET=replace_this_with_a_secure_random_string_min_32_chars

# Optional
ML_SERVICE_URL=
SENTRY_DSN=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
