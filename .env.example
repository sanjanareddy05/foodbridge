# ═══════════════════════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT VARIABLES
# For Render (Backend) and Vercel (Frontend)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── RENDER: Backend & Database ───────────────────────────────────────────────
# These go in Render environment variables for the backend service

NODE_ENV=production
PORT=4000

# Render PostgreSQL will provide this automatically
DATABASE_URL=postgresql://user:password@your-render-postgres-host:5432/foodbridge

# CORS origin — must match your Vercel frontend URL
CLIENT_URL=https://foodbridge.vercel.app

# Security secrets — Generate with: openssl rand -base64 32
JWT_SECRET=generate-secure-random-string-min-32-chars
REFRESH_TOKEN_SECRET=generate-secure-random-string-min-32-chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ─── VERCEL: Frontend ─────────────────────────────────────────────────────────
# These go in Vercel environment variables for the frontend

VITE_API_URL=https://your-render-backend-url.onrender.com/api

# ─── Optional Services ───────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
SENTRY_DSN=
