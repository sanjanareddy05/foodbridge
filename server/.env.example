# ═══════════════════════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT VARIABLES FOR RENDER
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Server Configuration ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ─── Database (Render PostgreSQL will provide this) ────────────────────────────
# Format: postgresql://user:password@hostname:5432/dbname
# Render will automatically set this — do NOT commit a real value to GitHub
DATABASE_URL=postgresql://user:password@your-render-db-host:5432/foodbridge

# ─── CORS Configuration (point to your Vercel frontend) ──────────────────────
# Replace with your actual Vercel deployment URL
CLIENT_URL=https://foodbridge.vercel.app

# ─── Authentication Secrets (MUST be at least 32 characters, random & unique) ──
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-generated-securely
REFRESH_TOKEN_SECRET=your-refresh-token-secret-min-32-chars-generated-securely
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ─── Database Connection Pool (adjust for Render) ──────────────────────────────
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── Optional: Google Maps Integration ───────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_MAPS_DIRECTIONS_URL=https://maps.googleapis.com/maps/api/directions/json

# ─── Optional: Error Tracking ────────────────────────────────────────────────
SENTRY_DSN=

# ─── Optional: Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── ML Service ───────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
ML_API_KEY=your_ml_service_api_key

# ─── Notifications ────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# ─── File Upload ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
